# =========================================================
# APPLICATION SETTINGS
# =========================================================
APP_NAME="GIAM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:3001

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =========================================================
# LOGGING
# =========================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================
# DATABASE
# =========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=giam_db
DB_USERNAME=root
DB_PASSWORD=

# =========================================================
# AUTHENTICATION & SECURITY
# =========================================================
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=43200                # Token lifetime in minutes (24 hours)
JWT_REFRESH_TTL=43200        # Token refresh lifetime (24 hours)
JWT_BLACKLIST_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=1440        # Session lifetime in minutes (24 hours)
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=user_sessions

LOGIN_LOCKOUT_SECONDS=5

# =========================================================
# CORS CONFIGURATION
# =========================================================
# Comma-separated list of allowed origins. In production: https://hub.cdp.lk
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_SUPPORTS_CREDENTIALS=true

# =========================================================
# CACHE, QUEUE & BROADCASTING
# =========================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# =========================================================
# REDIS / MEMCACHED
# =========================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# =========================================================
# MAIL
# =========================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================
# AWS (optional)
# =========================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================================================
# CENTRIX INTEGRATION
# =========================================================
CENTRIX_FRONTEND_URL=http://localhost:3001
CENTRIX_API_BASE_URL=http://localhost:8002/api/giam/integration
CENTRIX_CLIENT_ID=
CENTRIX_CLIENT_SECRET=

# =========================================================
# HRMS INTEGRATION
# =========================================================
HRMS_API_BASE_URL=
HRMS_CLIENT_ID=
HRMS_CLIENT_SECRET=

# =========================================================
# PAYROLL INTEGRATION
# =========================================================
PAYROLL_API_BASE_URL=
PAYROLL_CLIENT_ID=
PAYROLL_CLIENT_SECRET=

# =========================================================
# STOCKLY INTEGRATION
# =========================================================
STOCKLY_BASE_URL=
STOCKLY_API_BASE_URL=

# =========================================================
# FRONTEND (Vite)
# =========================================================
VITE_APP_NAME="${APP_NAME}"
